# =============================================================================
# Aerolloy Technologies Limited - Enterprise AI Assistant
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=Aerolloy Enterprise AI Assistant
APP_VERSION=2.0.0
ORG_NAME=Aerolloy Technologies Limited
ENVIRONMENT=development          # development | staging | production
DEBUG=True

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated list. In production set this to your real frontend origin(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=90
LOG_ROTATION=50 MB

# --- Security ----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_64_BYTE_URLSAFE_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Max failed logins before the account is temporarily locked
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Database ----------------------------------------------------------------
# Password must be URL-encoded (@ becomes %40)
DATABASE_URL=postgresql+psycopg://postgres:Lakshay%40123@localhost:5432/Enterprise_AI
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# Read-only role used by the SQL agent. Created by scripts/setup_db_roles.sql.
# This role can ONLY see department-scoped views - never the base tables.
SQL_AGENT_DATABASE_URL=postgresql+psycopg://ai_readonly:CHANGE_ME_READONLY_PASSWORD@localhost:5432/Enterprise_AI
SQL_AGENT_ENABLED=True
SQL_AGENT_MAX_ROWS=50

# --- Ollama (local LLM) ------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Main answering model. Pull with: ollama pull qwen2.5:14b-instruct
OLLAMA_MODEL=qwen2.5:14b-instruct
# Small fast model for routing / rewriting / grading. ollama pull qwen2.5:3b-instruct
OLLAMA_FAST_MODEL=qwen2.5:3b-instruct
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=180

# --- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
# BGE models want this prefix on queries (not on documents)
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBEDDING_DEVICE=cpu             # cpu | cuda

# --- Reranking ---------------------------------------------------------------
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_ENABLED=True
RERANKER_DEVICE=cpu              # cpu | cuda

# --- Chunking ----------------------------------------------------------------
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_CHARS=80

# --- Retrieval tuning --------------------------------------------------------
# How many candidates each retriever pulls before fusion
VECTOR_TOP_K=25
KEYWORD_TOP_K=25
# Reciprocal Rank Fusion constant
RRF_K=60
# How many fused candidates go to the reranker
RERANK_CANDIDATES=20
# How many survive to the LLM context
FINAL_TOP_K=6
# Below this rerank score a chunk is discarded as irrelevant
RERANK_SCORE_THRESHOLD=0.30
# If the best chunk scores below this, the bot refuses instead of guessing
MIN_CONFIDENCE_THRESHOLD=0.35

# --- Guardrails --------------------------------------------------------------
RELEVANCE_GATE_ENABLED=True
GROUNDING_CHECK_ENABLED=True

# --- Chat --------------------------------------------------------------------
# Turns of prior conversation kept in the LLM context window
CHAT_HISTORY_WINDOW=10
# Messages returned to the UI per conversation
CHAT_HISTORY_LIMIT=10
MAX_QUESTION_LENGTH=2000

# --- Storage -----------------------------------------------------------------
UPLOAD_DIR=uploads
KNOWLEDGE_BASE_DIR=knowledge_base
MAX_UPLOAD_SIZE_MB=50

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_LOGIN=10/minute
