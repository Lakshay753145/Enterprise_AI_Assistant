# ---- Application data -------------------------------------------------------
# Runtime artefacts. The audit and transcript archives are operational records,
# not source - keep them out of version control.
logs/
uploads/
vector_store/

# Knowledge-base source documents are confidential company documentation and
# must never be committed. Folder structure is kept via .gitkeep.
knowledge_base/**
!knowledge_base/**/
!knowledge_base/**/.gitkeep

# ---- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
